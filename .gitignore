node_modules/
dist/
.env
*.log

# First-run setup output (contains the Node API key — never commit it)
config.json

# THE NODE'S LOCAL DATA DIRECTORY (default: ./data beside the executable, i.e.
# this folder when running from source). It holds config.json, the Deep Brain
# SQLite database, downloaded models and the Playwright browser cache — all of it
# machine-local and some of it secret, so none of it belongs in git.
data/

# Deep Brain (SQLite) + WAL sidecars
*.db
*.db-shm
*.db-wal

# Brain-parity contract test scratch: node config with a PIN + local SQLite
.parity/

# Scratch emitted by scripts/verify-release-workflow.mjs: every `pwsh` step body
# with the GitHub expressions replaced, so PowerShell can parse-check them.
ps-check.ps1
# --- ANDROID / MOBILE BUILD ARTEFACTS -------------------------------------------
# Everything below is GENERATED by scripts/package-apk.mjs and is deliberately
# untracked, for one reason: mobile/android/ is a full Gradle project of several
# thousand generated files produced by `npx cap add android`. Committing it would
# mean merging upstream Capacitor template changes by hand on every upgrade, and
# it would swamp the real source in every diff.
#
# What IS committed is the small, meaningful part: mobile/capacitor.config.json,
# mobile/src/worker.ts, and mobile/android-overlay/ (the manifest plus the
# foreground service, plugin and boot receiver).
mobile/android/
mobile/www/
mobile/node_modules/
mobile/.gradle/
*.apk
*.aab

*.legacy_backup
