{
  "name": "rippa-node",
  "version": "1.0.37",
  "description": "Rippa Node â€” Deep Brain worker for Rippa Adventures: headless scraping, local LLM extraction (Ollama), and autonomous feature research.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "test:brain-parity": "tsx scripts/brain-parity-check.ts .parity/bundle.json",
    "test:verify": "npm run build && node scripts/verify-units.mjs && node scripts/verify-fixes.mjs && node scripts/verify-watchdog.mjs && node scripts/verify-governor.mjs",
    "test:governor": "npm run build && node scripts/verify-governor.mjs",
    "test:fleet": "npm run build && node scripts/verify-fleet-roles.mjs",
    "test:paths": "tsx scripts/verify-paths.mts",
    "test:mobile": "npm run build && node scripts/verify-mobile.mjs",
    "test:mobile:bundle": "node scripts/build-mobile-worker.mjs && node scripts/verify-mobile-bundle.mjs",
    "test:release-workflow": "node scripts/verify-release-workflow.mjs",
    "test:watchdog": "npm run build && node scripts/verify-watchdog.mjs",
    "test:ota": "npm run build && node scripts/verify-ota-handoff.mjs",
    "test:mobile:update": "node scripts/build-mobile-worker.mjs && node scripts/verify-mobile-update.mjs",
    "test:engine": "npm run build && node scripts/verify-engine-cli.mjs && node scripts/verify-engine-health.mjs && node scripts/verify-managed-ollama-origin.mjs && node scripts/verify-ollama-pull.mjs",
    "test:engine:routes": "node scripts/verify-engine-routes.mjs && node scripts/verify-engine-ui.mjs",
    "build:webgui": "node scripts/build-webgui.mjs",
    "package": "npm run build:webgui && node scripts/package.mjs",
    "build:watchdog": "tsc -p tsconfig.json && node scripts/build-watchdog.mjs",
    "watchdog": "tsx src/watchdog.ts",
    "watchdog:install": "npm run build:watchdog && node scripts/install-watchdog.mjs",
    "build:apk:bundle": "node scripts/build-mobile-worker.mjs",
    "package:apk": "node scripts/package-apk.mjs",
    "build:apk": "npm run build && node scripts/package-apk.mjs"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "node-cron": "^4.6.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/prebuilds/win32-x64.node",
      "node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "node_modules/playwright-core/browsers.json",
      "node_modules/playwright-core/package.json",
      "node_modules/playwright/package.json",
      "public/**/*",
      "public/index.html",
      "public/app.js",
      "public/styles.css",
      "public/dashboard.html",
      "public/dashboard.css",
      "public/dashboard.js"
    ]
  }
}
