# Rippa Node environment configuration.
# Copy this file to `.env` and fill in real values for this machine.

# Role of this node in the Master-Satellite architecture: 'master' or 'satellite'
NODE_ROLE=master
# Human-readable name for this node (appears in Mothership heartbeat)
NODE_NAME="Main Server PC"
# API key used to authenticate with the Cloudflare Mothership (Bearer token)
NODE_API_KEY="your_generated_key_here"
# Base URL of the cloud backend (Cloudflare Mothership)
MOTHERSHIP_URL="https://rippaadventures.com"
# LAN address satellites use to reach this master's local interrogation API
MASTER_LOCAL_URL="http://192.168.1.X:4000"
# Local Ollama instance used for LLM extraction
OLLAMA_URL="http://127.0.0.1:11434"
# Port for the local Express interrogation API
PORT=4000
# Dashboard passkey — lock screen for LAN access to the Command Center
# (default "12031994"; change it during initial setup via the Web GUI)
DASHBOARD_PIN="12031994"

# ── OVER-THE-AIR UPDATES ─────────────────────────────────────────────────────
# Set to "false" to stop the node updating itself (the hourly poll and any
# FORCE_UPDATE both go idle; the log says why on every check).
# OTA_ENABLED=true

# "owner/name" of the GitHub repository that publishes the releases. The default
# is the real repo; override it for a fork. A WRONG VALUE HERE LOOKS EXACTLY LIKE
# "no releases published", which is why the updater names this repo in its log.
# RIPPA_GITHUB_REPO="Farko420/rippa-node"

# The release asset the updater fetches by exact name from
# https://github.com/<repo>/releases/latest/download/<asset>
# That URL is a LITERAL FILENAME LOOKUP: anything other than this exact name 404s,
# and the release page will still look perfectly normal. Only change it if the
# workflow publishes a matching asset.
# RIPPA_GITHUB_ASSET="rippa-node.exe"

# A PRIVATE GitHub repository answers 404 to every anonymous request — deliberately,
# so the repo's existence is not disclosed — which is indistinguishable from "no
# releases yet". If the release repo is private, put a token with `contents: read`
# here. In CI, set the standard GITHUB_TOKEN secret instead; both names are read.
# A classic PAT needs no extra scopes beyond public repo read on a private repo.
# RIPPA_GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"

# ── THE RIPPA WATCHDOG (process supervision) ─────────────────────────────────
# Normally the watchdog starts this node, so you do not set anything here. This
# flag is set BY the watchdog on the child it spawns, and the node reads it to
# decide how to hand off an update: with a watchdog it exits 43 and lets the
# supervisor swap the binary; without one it keeps the legacy detached-script
# path. Set it by hand only to TEST handoff behaviour — if you set it while no
# watchdog is running, an update will exit 43 into nothing and the node will
# simply stop.
# RIPPA_WATCHDOG=1

# Only for supervising something other than the rippa-node.exe sitting beside the
# watchdog — for example running the supervisor against a dev build. Leave unset
# in a normal install: the watchdog and the node must be in the same folder,
# because the OTA swap replaces one with the other.
# RIPPA_NODE_EXE="C:\\Rippa\\rippa-node.exe"
